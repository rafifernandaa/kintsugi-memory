# ============================================================================
# Kintsugi Memory Environment Configuration
# ============================================================================

# 1. Google Gemini API (Required for AI Agents & Synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. Google Cloud Platform & Pub/Sub Settings
GOOGLE_CLOUD_PROJECT=my-project-31-491314
GOOGLE_CLOUD_PUBSUB_TOPIC=projects/my-project-31-491314/topics/kintsugi-cliff-pings
GOOGLE_CLOUD_PUBSUB_SUBSCRIPTION=kintsugi-cliff-pings-sub

# 3. SMTP Live Email Delivery (Required for sending emails directly to your Gmail inbox)
# Option A: Gmail (Free & Fast)
# - Enable 2-Step Verification on your Google Account
# - Create an App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=cubetestxyz@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Option B: Custom SMTP (Resend, SendGrid, Mailgun, Brevo, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=cubetestxyz@gmail.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Kintsugi Memory" <cubetestxyz@gmail.com>

# 4. Default Student Email for Forgetting-Cliff Notifications
USER_NOTIFICATION_EMAIL=cubetestxyz@gmail.com
