# ============================================================================
# Kintsugi Memory Environment Configuration
# ============================================================================

# 1. Google Gemini API (Required for AI Agents & Synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. Google Cloud Platform & Pub/Sub Settings
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_PUBSUB_TOPIC=projects/your-google-cloud-project-id/topics/kintsugi-cliff-pings
GOOGLE_CLOUD_PUBSUB_SUBSCRIPTION=kintsugi-cliff-pings-sub

# 3. SMTP Live Email Delivery (For Socratic challenges delivered to your inbox)
# Option A: Gmail
# - Enable 2-Step Verification on your Google Account
# - Create an App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Option B: Custom SMTP (Resend, SendGrid, Mailgun, Brevo, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Kintsugi Memory" <your-email@gmail.com>

# 4. Default Notification Email for Forgetting-Cliff Notifications
USER_NOTIFICATION_EMAIL=your-email@gmail.com
